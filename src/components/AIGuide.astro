---
import { Icon } from 'astro-icon/components';

const conversations = [
  {
    question: "What are the early warning signs of melanoma?",
    answer: "The ABCDE rule helps identify melanoma: Asymmetry, Border irregularity, Color variation, Diameter larger than 6mm, and Evolving appearance..."
  },
  {
    question: "How often should I get a skin cancer screening?",
    answer: "Annual skin exams are recommended for most adults. Those with higher risk factors or a history of skin cancer may need more frequent screenings every 3-6 months."
  },
  {
    question: "What's the difference between basal cell and squamous cell carcinoma?",
    answer: "Basal cell carcinoma grows slowly and rarely spreads, while squamous cell carcinoma grows faster and has a higher risk of spreading to other parts of the body if left untreated."
  },
  {
    question: "Can skin cancer be prevented?",
    answer: "Yes! Use broad-spectrum SPF 30+ sunscreen daily, seek shade during peak hours, wear protective clothing, avoid tanning beds, and perform regular self-examinations."
  }
];

const chatUrl = 'https://chatgpt.com/g/g-69045e9a6ad8819192dbd404ede6db6d-beating-skin-cancer-navigator';
---

<section id="ai-tools" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <h2 class="text-4xl font-serif text-navy mb-6">
          Your AI Guide, Always Here for You
        </h2>
        <p class="text-lg text-slate/70 mb-8 leading-relaxed">
          Our AI assistant is trained on the latest medical research and clinical guidelines
          to provide you with accurate, up-to-date information about skin cancer.
        </p>
        <div class="space-y-6">
          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-teal/10 rounded-full flex items-center justify-center">
                <Icon name="lucide:bot" class="text-teal" size={24} />
              </div>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-navy mb-2">24/7 Availability</h3>
              <p class="text-slate/70">Get answers to your questions anytime, day or night.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-teal/10 rounded-full flex items-center justify-center">
                <Icon name="lucide:shield" class="text-teal" size={24} />
              </div>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-navy mb-2">Evidence-Based</h3>
              <p class="text-slate/70">All information is backed by clinical guidelines & research.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-teal/10 rounded-full flex items-center justify-center">
                <Icon name="lucide:clock" class="text-teal" size={24} />
              </div>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-navy mb-2">Instant Responses</h3>
              <p class="text-slate/70">Get your answers whenever questions arise.</p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-teal/10 rounded-full flex items-center justify-center">
                <Icon name="lucide:users" class="text-teal" size={24} />
              </div>
            </div>
            <div>
              <h3 class="text-xl font-semibold text-navy mb-2">Physician-Created</h3>
              <p class="text-slate/70">Developed by board-certified physicians.</p>
            </div>
          </div>
        </div>
      </div>
      <div>
        <div class="bg-gradient-to-br from-teal/10 to-navy/5 rounded-2xl p-12 shadow-xl mb-8">
          <div id="ai-guide-question" class="bg-white rounded-xl p-6 shadow-md mb-4 transition-opacity duration-300">
            <p class="text-slate/60 text-sm mb-2">You</p>
            <p class="text-navy" id="ai-guide-question-text">{conversations[0].question}</p>
          </div>
          <div id="ai-guide-answer" class="bg-navy text-white rounded-xl p-6 shadow-md transition-opacity duration-300">
            <p class="text-white/80 text-sm mb-2">AI Assistant</p>
            <p id="ai-guide-answer-text">{conversations[0].answer}</p>
          </div>
        </div>
        <div class="text-center">
          <div class="flex flex-col items-center gap-2">
            <a
              href={chatUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-teal text-white px-8 py-3 rounded-full hover:bg-teal/90 transition-all shadow-lg hover:shadow-xl font-medium"
            >
              Chat with the Navigator
            </a>
            <p class="text-sm text-slate/60">Ask questions and get clear, trusted answers — instantly.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ conversations }}>
  let currentIndex = 0;
  const questionEl = document.getElementById('ai-guide-question-text');
  const answerEl = document.getElementById('ai-guide-answer-text');
  const questionBox = document.getElementById('ai-guide-question');
  const answerBox = document.getElementById('ai-guide-answer');

  setInterval(() => {
    currentIndex = (currentIndex + 1) % conversations.length;
    if (questionBox) questionBox.style.opacity = '0';
    if (answerBox) answerBox.style.opacity = '0';

    setTimeout(() => {
      if (questionEl) questionEl.textContent = conversations[currentIndex].question;
      if (answerEl) answerEl.textContent = conversations[currentIndex].answer;
      if (questionBox) questionBox.style.opacity = '1';
      if (answerBox) answerBox.style.opacity = '1';
    }, 150);
  }, 2000);
</script>
