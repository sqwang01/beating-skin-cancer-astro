---
import { Icon } from 'astro-icon/components';
---

<section id="about" class="py-20 bg-gradient-to-br from-navy to-slate text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-serif mb-6">Why Trust Us?</h2>
      <p class="text-xl text-white/80 max-w-3xl mx-auto leading-relaxed">
        Our platform combines cutting-edge AI technology with rigorous medical expertise
        to provide you with reliable, compassionate guidance.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-white/10 rounded-full mb-6">
          <Icon name="lucide:award" class="text-teal" size={32} />
        </div>
        <h3 class="text-xl font-semibold mb-3">Expert-Led</h3>
        <p class="text-white/70">
          Created and reviewed by board-certified physicians specializing in oncology and dermatology.
        </p>
      </div>

      <div class="text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-white/10 rounded-full mb-6">
          <Icon name="lucide:book-check" class="text-teal" size={32} />
        </div>
        <h3 class="text-xl font-semibold mb-3">Research-Backed</h3>
        <p class="text-white/70">
          Every piece of information is grounded in peer-reviewed medical literature.
        </p>
      </div>

      <div class="text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-white/10 rounded-full mb-6">
          <Icon name="lucide:heart" class="text-teal" size={32} />
        </div>
        <h3 class="text-xl font-semibold mb-3">Compassionate</h3>
        <p class="text-white/70">
          We understand the emotional journey and provide empathetic, supportive guidance.
        </p>
      </div>

      <div class="text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-white/10 rounded-full mb-6">
          <Icon name="lucide:users" class="text-teal" size={32} />
        </div>
        <h3 class="text-xl font-semibold mb-3">Patient-Focused</h3>
        <p class="text-white/70">
          Designed with patients in mind, making complex medical information accessible.
        </p>
      </div>
    </div>
  </div>
</section>
