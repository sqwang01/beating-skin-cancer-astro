---
const newsletterUrl = 'https://newsletter.beatingskincancer.com/hp/Rj20gf-NywoxZFOkP_ZuaQ/signup';
---

<footer class="bg-navy text-white py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-x-16">
      <div>
        <h3 class="text-xl font-serif mb-4">BeatingSkinCancer.com</h3>
        <p class="text-white/70 mb-6">
          Your trusted resource for skin cancer information and AI-powered guidance.
        </p>
        <h4 class="font-semibold mb-3">Disclaimer</h4>
        <p class="text-white/70 text-sm">
          This website provides general information only and does not constitute medical advice.
          Always consult with a qualified healthcare professional for diagnosis and treatment.
        </p>
      </div>
      <div class="text-center">
        <h4 class="font-semibold mb-4">Quick Links</h4>
        <ul class="space-y-2 text-white/70">
          <li><a href="/about" class="hover:text-teal transition-colors">About Us</a></li>
          <li><a href="/editorial-board" class="hover:text-teal transition-colors">Editorial Board</a></li>
          <li><a href="/questions-to-ask" class="hover:text-teal transition-colors">200 Smart Questions</a></li>
          <li><a href="#" class="hover:text-teal transition-colors">Contact</a></li>
          <li><a href="/privacy-policy" class="hover:text-teal transition-colors">Privacy Policy</a></li>
          <li><a href="/terms-of-service" class="hover:text-teal transition-colors">Terms of Service</a></li>
        </ul>
      </div>
      <div>
        <a
          href={newsletterUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="block text-center bg-teal text-white px-6 py-3 rounded-full hover:bg-teal/90 transition-all shadow-md hover:shadow-lg font-semibold mb-4 w-full"
        >
          Subscribe Now
        </a>
        <p class="text-white font-semibold mb-2">Stay Informed. Stay Protected.</p>
        <p class="text-white/70 text-sm">
          Get expert guidance on skin cancer prevention, treatment options, and the latest updates—all in plain language.
        </p>
      </div>
    </div>
    <div class="mt-8 pt-8 border-t border-white/20 text-center text-white/70">
      <p>
        &copy; 2025 Beating Cancers. Educational purposes only. Not medical advice. View our
        <a href="/privacy-policy" class="text-teal hover:underline">Privacy Policy</a> and
        <a href="/terms-of-service" class="text-teal hover:underline">Terms of Use</a>.
      </p>
    </div>
  </div>
</footer>
