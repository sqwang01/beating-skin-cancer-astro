---
import { DEFAULT_REVIEWER_SLUG, getBoardMember } from '../data/editorialBoard';

interface Props {
  date: string; // YYYY-MM-DD
  /** Board member slug from src/data/editorialBoard.ts. Defaults to the Editor-in-Chief. */
  reviewer?: string;
  /** 'dark' (default) for hero/gradient backgrounds; 'light' for white cards. */
  tone?: 'dark' | 'light';
  class?: string;
}

const {
  date,
  reviewer = DEFAULT_REVIEWER_SLUG,
  tone = 'dark',
  class: className = '',
} = Astro.props;
const member = getBoardMember(reviewer);

const formatted = new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const textClass = tone === 'light' ? 'text-slate/70' : 'text-white/70';
const dotClass = tone === 'light' ? 'text-slate/40' : 'text-white/40';
---

<div class:list={['flex flex-wrap items-center gap-x-2 gap-y-1 text-sm mt-4', textClass, className]}>
  <span>
    Medically reviewed by{' '}
    <a
      href={`/editorial-board#${member.slug}`}
      class="text-teal hover:text-teal/80 underline underline-offset-2"
    >
      Dr. {member.name}
    </a>
  </span>
  <span class={dotClass} aria-hidden="true">•</span>
  <span>Last reviewed <time datetime={date}>{formatted}</time></span>
</div>
