---
/**
 * Mad Rush global progress (MASTER_SPEC §5). Server-renders the four spine steps;
 * a client script fills in each step's mark (○ not started / ● in progress /
 * ✓ complete / ⏳ waiting / ! needs attention) from the local progress store.
 *
 * Language rule (MASTER_SPEC §5): marks reflect what the user recorded about
 * understanding a step — never an implication that medical treatment is done.
 */
import { MAD_RUSH_STEPS } from '../../data/navigator/journeyMap';

interface Props {
  /** Step id to show as the current step. */
  current?: string;
  heading?: string;
  class?: string;
}

const { current, heading = 'Mad Rush', class: className = '' } = Astro.props;
---

<section class:list={['rounded-2xl bg-white shadow-lg p-6 sm:p-8', className]} data-journey-progress>
  <div class="flex items-baseline justify-between mb-4">
    <h2 class="text-xl font-serif text-navy">{heading}</h2>
    <a href="/melanoma/navigator/mad-rush" class="text-sm text-teal hover:text-teal/80 underline underline-offset-2">
      View full journey
    </a>
  </div>

  <ol class="space-y-2">
    {MAD_RUSH_STEPS.map((step) => (
      <li
        class="flex items-start gap-3 rounded-lg p-2"
        data-step-id={step.id}
        data-current={current === step.id ? 'true' : 'false'}
      >
        <span
          class="mark inline-flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border border-slate/30 text-xs text-slate/60"
          aria-hidden="true"
        >○</span>
        <span class="min-w-0">
          {step.route ? (
            <a href={step.route} class="font-medium text-slate hover:text-teal transition-colors">
              {step.number}. {step.label}
            </a>
          ) : (
            <span class="font-medium text-slate/70">{step.number}. {step.label}</span>
          )}
          {step.status === 'coming_soon' && (
            <span class="ml-2 align-middle text-xs text-slate/50">coming soon</span>
          )}
          <span class="status-word ml-2 align-middle text-xs text-slate/50"></span>
        </span>
      </li>
    ))}
  </ol>
</section>

<script>
  import { getStepStatus } from '../../scripts/navigator/store.js';

  const MARKS = {
    not_started: { mark: '○', word: '' },
    in_progress: { mark: '●', word: 'in progress' },
    complete: { mark: '✓', word: 'I’ve reviewed this' },
    waiting: { mark: '⏳', word: 'waiting' },
    needs_attention: { mark: '!', word: 'needs attention' },
  };

  document.querySelectorAll('[data-journey-progress] [data-step-id]').forEach((li) => {
    const status = getStepStatus(li.dataset.stepId) || 'not_started';
    const info = MARKS[status] || MARKS.not_started;
    const mark = li.querySelector('.mark');
    const word = li.querySelector('.status-word');
    if (mark) mark.textContent = info.mark;
    if (word) word.textContent = info.word;
    if (status === 'complete' && mark) {
      mark.classList.add('bg-teal', 'text-white', 'border-teal');
      mark.classList.remove('text-slate/60');
    }
    if (li.dataset.current === 'true') {
      li.classList.add('bg-teal/5');
    }
  });
</script>
