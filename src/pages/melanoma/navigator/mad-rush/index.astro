---
import Layout from '../../../../layouts/Layout.astro';
import JourneyProgress from '../../../../components/navigator/JourneyProgress.astro';
import NavigatorFooterNotice from '../../../../components/navigator/NavigatorFooterNotice.astro';
import { MAD_RUSH_STEPS, OPTIONAL_MODULES, CONCERN_MESSAGE } from '../../../../data/navigator/journeyMap';

const title = 'The Mad Rush: Your Melanoma Journey Map | Beating Skin Cancer';
const description =
  'The Mad Rush is the first phase after a melanoma diagnosis: understand the pathology report, the stage, treatment options for that stage, and how to build the right care team.';
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-ivory">
    <div class="bg-gradient-to-br from-navy to-slate py-16 pt-32">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <a href="/melanoma/navigator" class="text-teal hover:text-teal/80 transition-colors mb-4 inline-block">
          ← Back to the Navigator
        </a>
        <p class="text-sm uppercase tracking-wide text-white/60 mb-2">Phase 1 of 2</p>
        <h1 class="text-3xl sm:text-4xl font-serif text-white mb-3">The Mad Rush</h1>
        <p class="text-lg text-white/80">
          The stretch from diagnosis through your initial treatment plan. Four steps, taken
          one at a time, in order. When they are done, the journey shifts into the Marathon —
          the long-term phase of follow-up and prevention.
        </p>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
      <JourneyProgress heading="Mad Rush — 4 steps" />

      <section class="rounded-2xl bg-white shadow-lg p-6 sm:p-8">
        <h2 class="text-xl font-serif text-navy mb-4">The four steps</h2>
        <ol class="space-y-4">
          {MAD_RUSH_STEPS.map((step) => (
            <li class="rounded-xl border border-slate/10 p-4">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <p class="font-medium text-navy">{step.number}. {step.label}</p>
                  {step.status === 'coming_soon' && (
                    <p class="text-xs text-slate/50 mt-1">Guided module coming soon</p>
                  )}
                </div>
                {step.route ? (
                  <a href={step.route} class="inline-flex flex-shrink-0 items-center gap-2 rounded-full bg-teal text-white px-5 py-2 text-sm font-medium hover:bg-teal/90 transition-colors">
                    {step.number === 1 ? 'Start' : 'Open'}
                  </a>
                ) : (
                  <span class="flex-shrink-0 rounded-full bg-slate/10 text-slate/50 px-4 py-2 text-sm">Soon</span>
                )}
              </div>
              {step.learnMore.length > 0 && (
                <ul class="mt-3 space-y-1 text-sm">
                  {step.learnMore.map((l) => (
                    <li>
                      <a href={l.href} class="text-teal underline underline-offset-2 hover:text-teal/80">{l.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>
      </section>

      <section class="rounded-2xl bg-white shadow-lg p-6 sm:p-8">
        <h2 class="text-xl font-serif text-navy mb-2">Optional: understand prognosis</h2>
        <p class="text-slate/80 text-sm mb-4">
          Survival statistics are not part of the four steps. Some people find them
          reassuring, others find them hard to read. You can open this whenever you are
          ready — or skip it entirely.
        </p>
        <ul class="space-y-2 text-sm">
          {OPTIONAL_MODULES.flatMap((m) => m.learnMore).map((l) => (
            <li>
              <a href={l.href} class="text-teal underline underline-offset-2 hover:text-teal/80">{l.label}</a>
            </li>
          ))}
        </ul>
      </section>

      <section class="rounded-2xl bg-coral/5 border border-coral/20 p-6">
        <h2 class="text-lg font-serif text-navy mb-2">{CONCERN_MESSAGE.title}</h2>
        <p class="text-slate/80 text-sm mb-3">{CONCERN_MESSAGE.body[0]}</p>
        <a href={CONCERN_MESSAGE.cta.href} class="text-teal underline underline-offset-2 hover:text-teal/80 text-sm">
          {CONCERN_MESSAGE.cta.label}
        </a>
      </section>

      <NavigatorFooterNotice />
    </div>
  </div>
</Layout>
