---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { galleryCategoryMeta, getGalleryCases, type GalleryCategory } from '../../data/gallery';

const canonical = 'https://www.beatingskincancer.com/gallery';
const title = 'Skin Cancer Photo Gallery | Beating Skin Cancer';
const description =
  'A biopsy-proven clinical and dermoscopy photo atlas of skin cancer, organized by diagnosis, from real patient cases.';

const categories = (Object.keys(galleryCategoryMeta) as GalleryCategory[]).map((category) => ({
  category,
  ...galleryCategoryMeta[category],
  count: getGalleryCases(category).length,
}));

const breadcrumbsJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.beatingskincancer.com/' },
    { '@type': 'ListItem', position: 2, name: 'Image Gallery', item: canonical },
  ],
};

const jsonLd = [breadcrumbsJsonLd];
---

<Layout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
  <div class="min-h-screen bg-ivory">
    <div class="bg-gradient-to-br from-navy to-slate py-20 pt-32">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl sm:text-5xl font-serif text-white mb-4">Skin Cancer Photo Gallery</h1>
        <p class="text-xl text-white/80">
          Real, biopsy-proven clinical and dermoscopy images from patient cases — browse by diagnosis.
        </p>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="bg-coral/5 rounded-2xl shadow-lg p-6 mb-8 flex items-start gap-4">
        <Icon name="lucide:alert-triangle" class="text-coral flex-shrink-0 mt-1" size={28} />
        <p class="text-slate/80">
          <strong>For education, not diagnosis.</strong> These photos illustrate how each skin cancer can
          appear — they cannot replace an in-person exam. If you notice a new or changing spot, see a
          board-certified dermatologist.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {categories.map(({ category, label, path, count }) =>
          count > 0 ? (
            <a href={path} class="bg-white rounded-2xl shadow-lg p-8 hover:shadow-xl transition-shadow group">
              <div class="flex items-center justify-between mb-3">
                <h2 class="text-2xl font-serif text-navy group-hover:text-teal transition-colors">{label}</h2>
                <Icon name="lucide:arrow-right" class="text-teal flex-shrink-0" size={24} />
              </div>
              <p class="text-slate/70">{count} case{count === 1 ? '' : 's'} — clinical &amp; dermoscopy pairs</p>
            </a>
          ) : (
            <div class="bg-white/60 rounded-2xl shadow-sm p-8 opacity-70">
              <h2 class="text-2xl font-serif text-slate/50 mb-3">{label}</h2>
              <p class="text-slate/50">Coming soon</p>
            </div>
          ),
        )}
      </div>
    </div>
  </div>
</Layout>
