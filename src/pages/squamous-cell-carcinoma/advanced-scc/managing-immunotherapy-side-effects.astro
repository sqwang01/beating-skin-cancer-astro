---
import Layout from '../../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import MedicalReviewer from '../../../components/MedicalReviewer.astro';
import { medicalReviewJsonLd } from '../../../lib/seo';

const canonical = "https://www.beatingskincancer.com/squamous-cell-carcinoma/advanced-scc/managing-immunotherapy-side-effects";
const lastReviewed = "2026-08-31";
const title = "Managing Immunotherapy Side Effects | Beating Skin Cancer";
const description = "How immune-related side effects of PD-1 immunotherapy for advanced SCC are monitored and managed, when treatment is paused, and when to call your team.";

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "How Are the Side Effects of Immunotherapy Managed?",
  "description": description,
  "author": { "@type": "Organization", "name": "Beating Skin Cancer" },
  "publisher": { "@type": "Organization", "name": "Beating Skin Cancer" },
  "mainEntityOfPage": canonical,
};

const breadcrumbsJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.beatingskincancer.com/" },
    { "@type": "ListItem", "position": 2, "name": "Squamous Cell Carcinoma", "item": "https://www.beatingskincancer.com/squamous-cell-carcinoma" },
    { "@type": "ListItem", "position": 3, "name": "Advanced Squamous Cell Carcinoma", "item": "https://www.beatingskincancer.com/squamous-cell-carcinoma/advanced-scc" },
    { "@type": "ListItem", "position": 4, "name": "Managing Immunotherapy Side Effects", "item": canonical }
  ],
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are immune-related adverse events?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Immune-related adverse events (irAEs) are side effects that happen because a PD-1 inhibitor removes a brake from the immune system, allowing it to inflame healthy organs as well as the tumor. They can affect the skin, colon, liver, lungs, kidneys, hormone-producing glands, joints, and — rarely — the heart or nervous system. Most appear in the first few months but they can occur at any time, even after treatment ends."
      }
    },
    {
      "@type": "Question",
      "name": "Does a side effect mean I have to stop immunotherapy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not always. Mild reactions are often managed while treatment continues. Moderate ones usually mean pausing the drug and starting corticosteroids until things settle, after which treatment can often resume. Severe or life-threatening reactions, and most cases involving the lungs, nervous system, or heart, generally mean stopping the drug permanently. Hormone problems are an exception — they are treated with hormone replacement and treatment can usually continue."
      }
    },
    {
      "@type": "Question",
      "name": "Which immunotherapy side effects need urgent medical attention?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Call your care team right away for new or worsening diarrhea or blood in the stool, belly pain, shortness of breath or a new cough, yellowing of the skin or eyes, severe fatigue or dizziness, a widespread or blistering rash, severe headache or vision changes, extreme thirst and urination, chest pain or palpitations, or new muscle weakness or trouble swallowing. Early treatment is what keeps these reactions reversible."
      }
    }
  ]
};

const jsonLd = [articleJsonLd, breadcrumbsJsonLd, faqJsonLd, medicalReviewJsonLd(canonical, lastReviewed)];
---

<Layout title={title} description={description} canonical={canonical} jsonLd={jsonLd}>
<div class="min-h-screen bg-ivory">
      <div class="bg-gradient-to-br from-navy to-slate py-20 pt-32">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <a href="/squamous-cell-carcinoma/advanced-scc"
            class="text-teal hover:text-teal/80 transition-colors mb-4 inline-block"
          >
            ← Back to Advanced Squamous Cell Carcinoma
          </a>
          <h1 class="text-4xl sm:text-5xl font-serif text-white mb-4">
            How Are the Side Effects of Immunotherapy Managed?
          </h1>
          <p class="text-xl text-white/80">Immune-related adverse events, monitoring, and when treatment is paused</p>
          <MedicalReviewer date={lastReviewed} />
        </div>
      </div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
          <h2 class="text-3xl font-serif text-navy mb-6">Introduction</h2>
          <p class="text-slate/80 text-lg leading-relaxed mb-4">
            <a href="/squamous-cell-carcinoma/advanced-scc/immunotherapy-for-advanced-scc" class="text-teal hover:text-teal/80 underline">PD-1 inhibitor immunotherapy</a> — cemiplimab or pembrolizumab — is the first-line systemic treatment for <a href="/squamous-cell-carcinoma/advanced-scc/what-advanced-scc-means" class="text-teal hover:text-teal/80 underline">advanced cutaneous squamous cell carcinoma</a>. Many people tolerate it well, and its side effects are different from those of chemotherapy: there is usually no hair loss, and nausea and low blood counts are uncommon.
          </p>
          <p class="text-slate/80 text-lg leading-relaxed">
            The trade-off is a distinct set of problems called <strong>immune-related adverse events</strong>. This article explains what they are, the routine monitoring used to catch them early, how doctors decide whether to keep going, pause, or stop, why some effects need lifelong treatment while the drug continues, the special situation for transplant recipients, and the symptoms that mean you should call your team without waiting.
          </p>
        </div>

        <div class="bg-gradient-to-br from-navy to-slate rounded-2xl shadow-lg p-8 text-center mb-8">
          <h3 class="text-2xl font-serif text-white mb-4">Have Questions?</h3>
          <p class="text-white/80 mb-6">Ask questions and get clear, trusted answers — instantly.</p>
          <a
            href="https://chatgpt.com/g/g-69045e9a6ad8819192dbd404ede6db6d-beating-skin-cancer-navigator"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-teal text-white px-8 py-3 rounded-full hover:bg-teal/90 transition-all shadow-md hover:shadow-lg font-medium"
          >
            Chat with the Navigator
          </a>
        </div>

        <div class="bg-teal/5 rounded-2xl shadow-lg p-8 mb-8">
          <div class="flex items-start gap-4 mb-6">
            <Icon name="lucide:shield" class="text-teal flex-shrink-0 mt-1" size={32} aria-hidden="true" />
            <div>
              <h2 class="text-3xl font-serif text-navy mb-4">What "Immune-Related" Means</h2>
              <p class="text-slate/80 mb-4">
                A PD-1 inhibitor works by taking a brake off the immune system so it can attack the cancer. The same released brake can let the immune system inflame <strong>healthy tissue</strong>. Those reactions are called immune-related adverse events, or irAEs, and they behave more like a temporary autoimmune disease than like a drug allergy.
              </p>
              <p class="text-slate/80 mb-4">
                They can involve almost any organ. Most show up in the <strong>first few weeks to months</strong> of treatment, but they can appear after a single dose or months after the last one. Because the immune system has a long memory, an irAE sometimes needs weeks of treatment to settle.
              </p>
              <p class="text-slate/80">
                The severity of each reaction is scored on a standard 1-to-4 scale called <strong>CTCAE</strong> (Common Terminology Criteria for Adverse Events): grade 1 is mild, grade 2 moderate, grade 3 severe, grade 4 life-threatening. That grade, along with which organ is affected, is what drives every decision about steroids and about holding or stopping the drug.
              </p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
          <h2 class="text-3xl font-serif text-navy mb-6">The Common and Organ-Specific Reactions</h2>
          <div class="space-y-6">
            <div class="bg-teal/5 rounded-lg p-6">
              <h3 class="text-2xl font-serif text-navy mb-3">Skin</h3>
              <p class="text-slate/80">
                The most common irAE. Usually an itchy rash or dry skin; less often patches of lost pigment (vitiligo). Managed with moisturizers, topical steroid creams, and antihistamines. A rare but serious blistering rash or a rash covering much of the body is treated urgently and can mean stopping the drug.
              </p>
            </div>
            <div class="bg-ivory rounded-lg p-6">
              <h3 class="text-2xl font-serif text-navy mb-3">Colon (colitis) and diarrhea</h3>
              <p class="text-slate/80">
                Loose stools, more frequent stools, cramping, or blood or mucus in the stool. Mild cases are managed with anti-diarrheal medicine and fluids; more than a few extra stools a day, or any blood, prompts holding the drug and starting corticosteroids. Steroid-resistant colitis is treated with a second drug such as infliximab.
              </p>
            </div>
            <div class="bg-teal/5 rounded-lg p-6">
              <h3 class="text-2xl font-serif text-navy mb-3">Liver (hepatitis)</h3>
              <p class="text-slate/80">
                Usually silent and picked up as rising liver enzymes on routine bloodwork; sometimes yellowing of the skin or eyes, dark urine, or right-sided abdominal pain. Managed by holding the drug and, if significant, corticosteroids.
              </p>
            </div>
            <div class="bg-ivory rounded-lg p-6">
              <h3 class="text-2xl font-serif text-navy mb-3">Hormone glands (endocrinopathies)</h3>
              <p class="text-slate/80">
                The thyroid is affected most often — first an overactive phase, then an underactive one needing thyroid hormone tablets. Less commonly the pituitary gland (hypophysitis) or adrenal glands are involved, causing severe fatigue, low blood pressure, or low sodium; rarely, the pancreas, causing sudden diabetes. These are discussed in more detail below.
              </p>
            </div>
            <div class="bg-teal/5 rounded-lg p-6">
              <h3 class="text-2xl font-serif text-navy mb-3">Lungs (pneumonitis)</h3>
              <p class="text-slate/80">
                Inflammation of lung tissue causing a new or worsening cough, breathlessness, or chest tightness. It is uncommon but potentially serious, so any new breathing symptom is checked promptly with a scan. It usually means holding the drug and starting corticosteroids, and moderate-to-severe cases often mean stopping it for good.
              </p>
            </div>
            <div class="bg-ivory rounded-lg p-6">
              <h3 class="text-2xl font-serif text-navy mb-3">Kidneys (nephritis)</h3>
              <p class="text-slate/80">
                Usually detected as a rising creatinine level on blood tests, with few symptoms. Managed by holding the drug and, when needed, corticosteroids; kidney function usually recovers.
              </p>
            </div>
            <div class="bg-teal/5 rounded-lg p-6">
              <h3 class="text-2xl font-serif text-navy mb-3">Rare but serious: heart and nervous system</h3>
              <p class="text-slate/80">
                Inflammation of the heart muscle (myocarditis), and neurologic reactions affecting nerves or muscles (weakness, drooping eyelids, trouble swallowing or breathing, numbness that spreads), are uncommon but can be dangerous. They are treated as emergencies with high-dose steroids and usually permanent discontinuation of the drug.
              </p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
          <h2 class="text-3xl font-serif text-navy mb-4">Routine Monitoring</h2>
          <p class="text-slate/80 mb-4">
            Because several irAEs cause no symptoms until they are advanced, monitoring is built into every cycle:
          </p>
          <ul class="space-y-3 text-slate/80 mb-4">
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span><strong>Bloodwork before each infusion:</strong> blood counts; liver enzymes and bilirubin; kidney function; and thyroid tests (TSH and free T4).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span><strong>Symptom review at every visit:</strong> a checklist covering bowels, breathing, energy, skin, headache, vision, and muscle strength.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span><strong>Extra tests when something is off:</strong> a morning cortisol and ACTH level if fatigue or low blood pressure suggest an adrenal or pituitary problem; blood sugar if diabetes is suspected; a chest scan for breathing symptoms; heart tests (troponin, ECG) if myocarditis is a concern.</span>
            </li>
          </ul>
          <p class="text-slate/80">
            Keeping a simple daily note of new symptoms between visits helps the team catch a reaction while it is still mild and easy to reverse.
          </p>
        </div>

        <div class="bg-teal/5 rounded-2xl shadow-lg p-8 mb-8">
          <div class="flex items-start gap-4 mb-6">
            <Icon name="lucide:activity" class="text-teal flex-shrink-0 mt-1" size={32} aria-hidden="true" />
            <div>
              <h2 class="text-3xl font-serif text-navy mb-4">The Steroid Ladder: Continue, Hold, or Stop</h2>
              <p class="text-slate/80 mb-4">
                National guidelines from the American Society of Clinical Oncology and others tie management to the CTCAE grade:
              </p>
              <ul class="space-y-3 text-slate/80">
                <li class="flex items-start gap-2">
                  <span class="text-teal mt-1">•</span>
                  <span><strong>Grade 1 (mild):</strong> usually continue immunotherapy with closer monitoring and local treatment such as steroid cream for a mild rash. Exceptions are early heart or neurologic signs, which are always taken seriously.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-teal mt-1">•</span>
                  <span><strong>Grade 2 (moderate):</strong> hold the drug and start oral corticosteroids (typically prednisone around 0.5–1 mg per kg per day). When symptoms improve to grade 1 or less, the steroid is tapered slowly over at least 4 weeks and immunotherapy is often restarted.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-teal mt-1">•</span>
                  <span><strong>Grade 3 (severe):</strong> hold or permanently discontinue depending on the organ; higher-dose corticosteroids (1–2 mg per kg per day), sometimes intravenously. If there is no improvement in 2–3 days, a second immune-suppressing drug is added — for example infliximab for colitis, mycophenolate for hepatitis.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-teal mt-1">•</span>
                  <span><strong>Grade 4 (life-threatening):</strong> permanently discontinue (with rare exceptions such as some hormone problems), hospital admission, and high-dose intravenous steroids.</span>
                </li>
              </ul>
              <p class="text-slate/80 mt-4">
                A course of steroids that lasts more than a few weeks comes with its own supportive care — stomach protection, sometimes an antibiotic to prevent a specific pneumonia, and monitoring of blood sugar and bone health. Taking steroids for an irAE does <strong>not</strong> appear to cancel out immunotherapy's benefit against the cancer.
              </p>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
          <h2 class="text-3xl font-serif text-navy mb-4">Hormone Effects That Need Lifelong Replacement</h2>
          <p class="text-slate/80 mb-4">
            Endocrine irAEs are the main exception to the "hold and treat with steroids" pattern. When the immune system damages a hormone gland, the missing hormone often does not come back — but it can be replaced, and treatment can usually continue.
          </p>
          <ul class="space-y-3 text-slate/80 mb-4">
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span><strong>Underactive thyroid:</strong> a daily thyroid hormone tablet (levothyroxine), often for life. Immunotherapy continues.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span><strong>Pituitary or adrenal insufficiency:</strong> daily hydrocortisone (a physiologic replacement dose, not a high anti-inflammatory dose), sometimes permanently, with a plan to increase the dose during illness.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-teal mt-1">•</span>
              <span><strong>Immunotherapy-induced diabetes:</strong> insulin, usually for life, started urgently because it can appear suddenly.</span>
            </li>
          </ul>
          <p class="text-slate/80">
            Once the hormone is replaced and the person is stable, the PD-1 inhibitor is generally resumed. An endocrinologist typically co-manages these situations.
          </p>
        </div>

        <div class="bg-coral/5 rounded-2xl shadow-lg p-8 mb-8">
          <div class="flex items-start gap-4 mb-6">
            <Icon name="lucide:alert-triangle" class="text-coral flex-shrink-0 mt-1" size={32} aria-hidden="true" />
            <div>
              <h2 class="text-3xl font-serif text-navy mb-4">Transplant Recipients: Rejection, Not Just irAEs</h2>
              <p class="text-slate/80 mb-4">
                In someone with a transplanted kidney, liver, heart, or lung, releasing the immune brake can make the immune system attack the <strong>donor organ</strong>. In published series, roughly 40% of solid-organ transplant recipients treated with a checkpoint inhibitor experienced rejection, and many lost the organ.
              </p>
              <p class="text-slate/80">
                Managing this is different from managing a standard irAE: it involves the transplant team, close monitoring of organ function, adjustments to anti-rejection medication, and sometimes preventive steroids from the start. It is one reason non-immunotherapy treatments are often considered first — see <a href="/squamous-cell-carcinoma/advanced-scc/scc-in-transplant-and-immunosuppressed-patients" class="text-teal hover:text-teal/80 underline">advanced SCC in transplant recipients and immunosuppressed patients</a>.
              </p>
            </div>
          </div>
        </div>

        <div class="bg-coral/5 rounded-2xl shadow-lg p-8 mb-8">
          <div class="flex items-start gap-4 mb-6">
            <Icon name="lucide:phone-call" class="text-coral flex-shrink-0 mt-1" size={32} aria-hidden="true" />
            <div>
              <h2 class="text-3xl font-serif text-navy mb-4">When to Call Your Care Team Urgently</h2>
              <p class="text-slate/80 mb-4">
                Do not wait for your next appointment if you have:
              </p>
              <ul class="space-y-3 text-slate/80">
                <li class="flex items-start gap-2">
                  <span class="text-coral mt-1">•</span>
                  <span>New or worsening diarrhea, or blood or mucus in the stool, or persistent abdominal pain</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-coral mt-1">•</span>
                  <span>Shortness of breath, a new cough, or chest tightness</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-coral mt-1">•</span>
                  <span>Yellowing of the skin or eyes, or dark urine</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-coral mt-1">•</span>
                  <span>Severe fatigue, dizziness or fainting, or confusion (possible adrenal or pituitary problem)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-coral mt-1">•</span>
                  <span>Extreme thirst, frequent urination, or unexplained weight loss (possible new diabetes)</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-coral mt-1">•</span>
                  <span>Chest pain, a racing or irregular heartbeat, or swelling in the legs</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-coral mt-1">•</span>
                  <span>New muscle weakness, drooping eyelids, double vision, or trouble swallowing or breathing</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-coral mt-1">•</span>
                  <span>A rash that is spreading quickly, blistering, or peeling, or any skin sores in the mouth</span>
                </li>
              </ul>
              <p class="text-slate/80 mt-4">
                Tell any clinician you see — including in an emergency room — that you are on immunotherapy, because the treatment for these reactions (steroids and other immune suppressants) is different from the usual approach.
              </p>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-br from-teal/10 to-teal/5 rounded-2xl shadow-lg p-8 mb-8">
          <div class="flex items-start gap-4 mb-4">
            <Icon name="lucide:heart" class="text-teal flex-shrink-0 mt-1" size={32} aria-hidden="true" />
            <div>
              <h2 class="text-3xl font-serif text-navy mb-4">What to Ask Your Doctor</h2>
              <ol class="space-y-3 text-slate/80 list-decimal list-inside">
                <li>Which side effects are most likely for me, and which are the dangerous ones to watch for?</li>
                <li>What blood tests will you run before each infusion, and what are you looking for?</li>
                <li>At what point would we pause treatment, and at what point would we stop it for good?</li>
                <li>If I need steroids, how long would that last, and what else do I need while taking them?</li>
                <li>If I develop a thyroid or other hormone problem, can I stay on immunotherapy?</li>
                <li>Who do I call after hours, and what symptoms should send me straight to the emergency room?</li>
              </ol>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
          <h2 class="text-3xl font-serif text-navy mb-4">Conclusion</h2>
          <p class="text-slate/80 mb-4">
            The side effects of PD-1 immunotherapy come from an over-active immune system rather than a toxic drug, so the response is to calm that inflammation — usually with corticosteroids — and to decide, based on how severe the reaction is and which organ is involved, whether to continue, pause, or stop. Routine bloodwork and a low threshold for reporting symptoms are what keep most reactions mild and reversible.
          </p>
          <p class="text-slate/80">
            Some effects, especially on hormone glands, are permanent and need lifelong replacement — but even then, treatment against the cancer can often continue. For how these drugs work and what they achieve, see <a href="/squamous-cell-carcinoma/advanced-scc/immunotherapy-for-advanced-scc" class="text-teal hover:text-teal/80 underline">how immunotherapy treats advanced SCC</a>.
          </p>
        </div>

        <div class="bg-slate/5 rounded-2xl shadow-lg p-8 mb-8">
          <div class="flex items-start gap-4">
            <Icon name="lucide:book-open" class="text-slate flex-shrink-0 mt-1" size={28} aria-hidden="true" />
            <div>
              <h2 class="text-xl font-serif text-navy mb-4">Sources</h2>
              <h3 class="text-sm font-semibold text-navy/70 uppercase tracking-wide mb-2">Clinical Guidelines &amp; Peer-Reviewed Literature</h3>
              <ul class="space-y-2 text-sm text-slate/70 mb-4">
                <li>
                  Schneider BJ, Naidoo J, Santomasso BD, et al. Management of immune-related adverse events in patients treated with immune checkpoint inhibitor therapy: ASCO guideline update. <em>J Clin Oncol.</em> 2021;39(36):4073-4126. <a href="https://pubmed.ncbi.nlm.nih.gov/34724392/" target="_blank" rel="noopener noreferrer" class="text-teal hover:text-teal/80 underline">PubMed</a>
                </li>
                <li>
                  Brahmer JR, Lacchetti C, Schneider BJ, et al. Management of immune-related adverse events in patients treated with immune checkpoint inhibitor therapy: American Society of Clinical Oncology clinical practice guideline. <em>J Clin Oncol.</em> 2018;36(17):1714-1768. <a href="https://pubmed.ncbi.nlm.nih.gov/29442540/" target="_blank" rel="noopener noreferrer" class="text-teal hover:text-teal/80 underline">PubMed</a>
                </li>
                <li>
                  Postow MA, Sidlow R, Hellmann MD. Immune-related adverse events associated with immune checkpoint blockade. <em>N Engl J Med.</em> 2018;378(2):158-168. <a href="https://pubmed.ncbi.nlm.nih.gov/29320654/" target="_blank" rel="noopener noreferrer" class="text-teal hover:text-teal/80 underline">PubMed</a>
                </li>
                <li>
                  Migden MR, Rischin D, Schmults CD, et al. PD-1 blockade with cemiplimab in advanced cutaneous squamous-cell carcinoma. <em>N Engl J Med.</em> 2018;379(4):341-351. <a href="https://pubmed.ncbi.nlm.nih.gov/29863979/" target="_blank" rel="noopener noreferrer" class="text-teal hover:text-teal/80 underline">PubMed</a>
                </li>
                <li>
                  Ji S, Liu H, Pachella L, et al. Use of immune checkpoint inhibitors in solid organ transplant recipients with advanced cutaneous malignancies. <em>Front Transplant.</em> 2023;2:1284740. <a href="https://pubmed.ncbi.nlm.nih.gov/38993910/" target="_blank" rel="noopener noreferrer" class="text-teal hover:text-teal/80 underline">PubMed</a>
                </li>
              </ul>
              <h3 class="text-sm font-semibold text-navy/70 uppercase tracking-wide mb-2">Patient Resources</h3>
              <ul class="space-y-2 text-sm text-slate/70">
                <li>
                  <a href="https://www.cancer.gov/about-cancer/treatment/types/immunotherapy/side-effects" target="_blank" rel="noopener noreferrer" class="text-teal hover:text-teal/80 underline">National Cancer Institute (NCI)</a> — Immunotherapy Side Effects
                </li>
                <li>
                  <a href="https://www.cancer.org/cancer/managing-cancer/treatment-types/immunotherapy/immune-checkpoint-inhibitors.html" target="_blank" rel="noopener noreferrer" class="text-teal hover:text-teal/80 underline">American Cancer Society (ACS)</a> — Immune Checkpoint Inhibitors and Their Side Effects
                </li>
                <li>
                  <a href="https://www.skincancer.org/skin-cancer-information/squamous-cell-carcinoma/scc-treatment-options/" target="_blank" rel="noopener noreferrer" class="text-teal hover:text-teal/80 underline">The Skin Cancer Foundation</a> — Squamous Cell Carcinoma Treatment
                </li>
              </ul>
            </div>
